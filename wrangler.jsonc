// Konfiguracja Cloudflare Workers: pliki aplikacji z app/ + backend (worker.js → functions/api).
// Sekrety (Settings → Variables and Secrets): GITHUB_TOKEN, SESSION_SECRET, USERS.
// Płatności (Polar.sh): PLATNOSCI=on, POLAR_ORG_ID, POLAR_BENEFIT_ID, POLAR_CHECKOUT_URL (opcjonalnie CENA, PROBA_DNI, POLAR_API).
{
  "name": "wlew",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    // karty leków przechodzą przez worker: bez dostępu wydawana jest wersja darmowa
    "run_worker_first": ["/data/leki.json"]
  },
  // nie kasuj zmiennych ustawionych w panelu Cloudflare przy kolejnych wdrożeniach
  "keep_vars": true
}
